@page "/Acceso"
@model TherapEase.Web.Pages.Login.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Acceso";
    Layout = "_LayoutAcceso";
}


<main class="acceso">

    <section class="acceso-hero">
        <span class="acceso-hero__forma acceso-hero__forma--arriba" aria-hidden="true"></span>
        <span class="acceso-hero__forma acceso-hero__forma--abajo" aria-hidden="true"></span>

        <div class="marca marca--grande">
            <span class="marca__logo">
                <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 2v2" />
                    <path d="M5 2v2" />
                    <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1" />
                    <path d="M8 15a6 6 0 0 0 12 0v-3" />
                    <circle cx="20" cy="10" r="2" />
                </svg>
            </span>
            <div>
                <div class="marca__nombre">TherapEase</div>
                <div class="marca__detalle">Gestión de pacientes y citas</div>
            </div>
        </div>

        <div class="acceso-hero__mensaje">
            <p class="acceso-hero__etiqueta">
                <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                Tu consulta, mejor organizada
            </p>
            <p class="acceso-hero__titulo">
                Todo lo que necesitas.<br />
                En un solo lugar.
            </p>
            <p class="acceso-hero__texto">
                Pacientes y citas, organizados de forma sencilla y segura.
            </p>
        </div>
    </section>

    <section class="acceso-panel">
        <div class="acceso-panel__contenido">

            <div class="marca marca--movil">
                <span class="marca__logo">
                    <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 2v2" />
                        <path d="M5 2v2" />
                        <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1" />
                        <path d="M8 15a6 6 0 0 0 12 0v-3" />
                        <circle cx="20" cy="10" r="2" />
                    </svg>
                </span>
                <div class="marca__nombre">TherapEase</div>
            </div>

            <div class="acceso-panel__encabezado">
                <h1 class="acceso-panel__titulo">Bienvenido de nuevo</h1>
                <p class="acceso-panel__texto">Accede a tu espacio de trabajo para comenzar.</p>
            </div>
            <!-- Evita que DataProtection intente usar la base de datos -->
            <form method="post" class="formulario-acceso">

                <!-- Quita "hidden" para ver el error -->
                <div class="alerta-error" role="alert" hidden>
                    Usuario o contraseña incorrectos.
                </div>

                <div class="campo">
                    <label class="campo__etiqueta" for="Entrada_NombreUsuario">Nombre de usuario</label>
                    <div class="campo__control">
                        <svg class="campo__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <input class="campo__entrada" id="Entrada_NombreUsuario" name="Entrada.NombreUsuario"
                               type="text" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                    </div>
                </div>

                <div class="campo">
                    <label class="campo__etiqueta" for="Entrada_Contrasena">Contraseña</label>
                    <div class="campo__control">
                        <svg class="campo__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="16" r="1" />
                            <rect x="3" y="10" width="18" height="12" rx="2" />
                            <path d="M7 10V7a5 5 0 0 1 10 0v3" />
                        </svg>
                        <input class="campo__entrada" id="Entrada_Contrasena" name="Entrada.Contrasena"
                               type="password" autocomplete="current-password" />
                    </div>
                </div>

                <button type="submit" class="boton boton--primario boton--completo">Iniciar sesión</button>
            </form>

            <p class="acceso-panel__pie">Entorno de validación · solo datos ficticios</p>
        </div>
    </section>

</main>