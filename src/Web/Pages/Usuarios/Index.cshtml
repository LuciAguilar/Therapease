@page
@using TherapEase.Application.Identidad.Constantes
@model IndexModel
@{
    Layout = "_LayoutOperativo";
    ViewData["Title"] = "Usuarios";
}
<header class="titulo-seccion fila">
    <div><h1>Usuarios</h1><p>Administra los accesos y permisos de tu equipo.</p></div>
    <a class="accion primaria" asp-page="Crear">+ Crear usuario</a>
</header>
<form method="get" class="busqueda">
    <label for="busqueda">Buscar usuarios</label>
    <input id="busqueda" name="busqueda" type="search" maxlength="@LimitesDeIdentidad.LongitudMaximaBusquedaDeUsuarios" value="@Model.Busqueda" />
    <button class="accion" type="submit">Buscar</button>
</form>
@if (Model.Error is not null)
{
    <p class="error-formulario" role="alert">@Model.Error</p>
}
else if (Model.Cuentas.Count == 0)
{
    <p class="tarjeta">No se encontraron cuentas.</p>
}
@if (Model.Cuentas.Count == LimitesDeIdentidad.MaximoDeUsuariosListados)
{
    <p>Se muestran hasta @LimitesDeIdentidad.MaximoDeUsuariosListados cuentas. Afina la búsqueda para encontrar una en particular.</p>
}
<ul class="lista-tarjetas cuentas">
@foreach (var cuenta in Model.Cuentas)
{
    <li class="tarjeta fila">
        <div class="identidad">
            <span class="avatar" aria-hidden="true">@(cuenta.NombreUsuario.Length > 0 ? cuenta.NombreUsuario[..1].ToUpperInvariant() : "•")</span>
            <div>
                <strong>@(string.IsNullOrWhiteSpace(cuenta.NombreCompleto) ? cuenta.NombreUsuario : cuenta.NombreCompleto)</strong>
                @if (!string.IsNullOrWhiteSpace(cuenta.NombreCompleto))
                {
                    <div class="secundario">@cuenta.NombreUsuario</div>
                }
            </div>
        </div>
        <div class="acciones">
            <span class="etiqueta rol">@cuenta.Rol</span>
            <span class="etiqueta @(cuenta.Activo ? "activa" : "")">@(cuenta.Activo ? "Activa" : "Desactivada")</span>
            <a class="accion" asp-page="Detalle" asp-route-id="@cuenta.IdUsuario">Ver cuenta</a>
        </div>
    </li>
}
</ul>
