@page
@using Microsoft.AspNetCore.Authorization
@using TherapEase.Web.Seguridad
@inject IAuthorizationService Autorizacion
@model IndexModel
@{
    Layout = "_LayoutOperativo";
    ViewData["Title"] = "Inicio";
    string[] indicadores = ["Citas de hoy", "Próximas citas", "Pagos pendientes", "Pacientes nuevos"];
}
<header class="titulo-seccion fila">
    <div>
        <h1 id="saludo-inicio">Hola, @Model.Nombre</h1>
        <p>Aquí tienes el resumen de tu consulta.</p>
    </div>
    <div class="acciones">
        @if ((await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.RegistrarPacientes)).Succeeded
            && (await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.ConsultarPacientes)).Succeeded)
        {
            <a class="accion primaria nuevo-paciente" asp-page="/Pacientes/Crear">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                Nuevo paciente
            </a>
        }
        @if ((await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.AgendarCitas)).Succeeded
            && (await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.ConsultarPacientes)).Succeeded)
        {
            <a class="accion primaria nuevo-paciente" asp-page="/Agenda/Crear">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                Nueva cita
            </a>
        }
    </div>
</header>
<script src="~/js/saludo-inicio.js" asp-append-version="true" defer></script>
@if (Model.MensajeExito is not null)
{
    <partial name="_AvisoDeConfirmacion" model="Model.MensajeExito" />
}
<div class="indicadores">
    @foreach (var indicador in indicadores)
    {
        <section class="tarjeta indicador">
            <h2>@indicador</h2>
            <p class="valor-vacio">—</p>
            <p>Sin datos disponibles</p>
        </section>
    }
</div>
<div class="resumen">
    <section>
        <div class="fila">
            <h2>Citas de hoy</h2>
            @if ((await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.ConsultarAgenda)).Succeeded
                && (await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.ConsultarPacientes)).Succeeded)
            {
                <a class="accion primaria nuevo-paciente" asp-page="/Agenda/Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4M17 3v4M3 11h18" /></svg>
                    Ver agenda
                </a>
            }
        </div>
        <p class="tarjeta">Sin datos disponibles.</p>
    </section>
    <div class="lista-tarjetas">
        <section class="tarjeta siguiente-cita"><h2>Siguiente cita</h2><p>Sin datos disponibles.</p></section>
        <section class="tarjeta"><h2>Pagos pendientes</h2><p>Sin datos disponibles.</p></section>
    </div>
</div>
