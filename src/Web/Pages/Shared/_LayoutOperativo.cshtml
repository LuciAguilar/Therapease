@using Microsoft.AspNetCore.Authorization
@using TherapEase.Application.Identidad.Interfaces.Servicios
@using TherapEase.Web.Seguridad
@inject IAuthorizationService Autorizacion
@inject IServicioCuentaPropia CuentaPropia
@{
    var administra = (await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.AdministrarUsuarios)).Succeeded;
    var consultaPacientes = (await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.ConsultarPacientes)).Succeeded;
    var usuarios = Context.Request.Path.StartsWithSegments("/Usuarios");
    var pacientes = Context.Request.Path.StartsWithSegments("/Pacientes");
    var agenda = Context.Request.Path.StartsWithSegments("/Agenda");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/img/therapease-icono.png" asp-append-version="true" />
    <title>@ViewData["Title"] · TherapEase</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agenda.css" asp-append-version="true" />
</head>
<body class="operacion">
    <aside class="barra-lateral">
        <a class="marca" asp-page="/Index"><img class="marca__imagen" src="~/img/therapease-logo.png" asp-append-version="true" width="1100" height="260" alt="TherapEase" /></a>
        <nav aria-label="Espacio de trabajo">
            <p>Espacio de trabajo</p>
            <a asp-page="/Index" aria-current="@(Context.Request.Path == "/" || Context.Request.Path == "/Index" ? "page" : null)">Inicio</a>
            @if (consultaPacientes)
            {
                <a asp-page="/Pacientes/Index" aria-current="@(pacientes ? "page" : null)">Pacientes</a>
            }
            @if (consultaPacientes && (await Autorizacion.AuthorizeAsync(User, PoliticasDeAutorizacion.ConsultarAgenda)).Succeeded)
            {
                <a asp-page="/Agenda/Index" aria-current="@(agenda ? "page" : null)">Agenda</a>
            }
            @if (administra)
            {
                <a asp-page="/Usuarios/Index" aria-current="@(usuarios ? "page" : null)">Usuarios</a>
            }
        </nav>
        <div class="barra-cuenta">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var cuenta = await CuentaPropia.ObtenerMisDatosAsync(Context.RequestAborted);
                if (cuenta.Exito && cuenta.Datos is { Datos: var datos })
                {
                    var nombre = string.IsNullOrWhiteSpace(datos.NombreCompleto) ? datos.NombreUsuario : datos.NombreCompleto;
                    <div class="identidad perfil-lateral">
                        <span class="avatar" aria-hidden="true">@TherapEase.Web.Pages.Pacientes.IndexModel.Iniciales(nombre)</span>
                        <div>
                            <strong>@nombre</strong>
                            <span class="secundario">@datos.Rol</span>
                        </div>
                    </div>
                }
            }
            <a asp-page="/Cuenta/Contrasena">Cambiar contraseña</a>
            <partial name="_FormularioSalida" />
        </div>
    </aside>
    <div class="zona-trabajo">
        <main class="zona-contenido">@RenderBody()</main>
    </div>
    <dialog id="panel-nueva-cita" class="panel-ficha-paciente" aria-labelledby="titulo-panel-cita">
        <header class="fila">
            <div><h2 id="titulo-panel-cita">Nueva cita</h2><p class="cita-ayuda">Reserva un horario para la atención.</p></div>
            <form method="dialog">
                <button class="ficha-cerrar" aria-label="Cerrar nueva cita" autofocus>×</button>
            </form>
        </header>
        <div data-panel-contenido-cita aria-live="polite"></div>
    </dialog>
    <dialog id="panel-detalle-cita" class="panel-ficha-paciente" aria-labelledby="titulo-detalle-cita">
        <header class="fila">
            <div><h2 id="titulo-detalle-cita">Detalle de cita</h2><p class="cita-ayuda">Hora de Hermosillo</p></div>
            <form method="dialog">
                <button class="ficha-cerrar" aria-label="Cerrar detalle de cita" autofocus>×</button>
            </form>
        </header>
        <div data-panel-contenido-cita aria-live="polite"></div>
    </dialog>
    <script src="~/js/panel-cita.js" asp-append-version="true" defer></script>
    <script src="~/js/selectores-cita.js" asp-append-version="true" defer></script>
    <script src="~/js/reserva-cita.js" asp-append-version="true" defer></script>
    <script src="~/js/pago-cita.js" asp-append-version="true" defer></script>
    <script src="~/js/notificaciones.js" asp-append-version="true" defer></script>
</body>
</html>
