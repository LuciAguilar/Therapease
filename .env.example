# Ejemplo ficticio para configuracion local; no contiene credenciales reales.
# ASP.NET Core no carga .env automaticamente: define estas variables en el entorno (ver README, seccion 10).
# Los usuarios therapease_app y therapease_migrador los crea scripts/db/crear-roles.sql.
ASPNETCORE_ENVIRONMENT=Development
# Conexion de la aplicacion en ejecucion normal: sin permisos de esquema ni de modificar la auditoria.
ConnectionStrings__TherapEase="Host=localhost;Port=55432;Database=therapease_ficticia;Username=therapease_app;Password=FICTICIO_CAMBIAR_SOLO_LOCAL"
# Solo para aplicar migraciones con dotnet ef; la aplicacion no la usa.
ConnectionStrings__Migraciones="Host=localhost;Port=55432;Database=therapease_ficticia;Username=therapease_migrador;Password=FICTICIO_MIGRADOR_SOLO_LOCAL"
TZ=America/Hermosillo
